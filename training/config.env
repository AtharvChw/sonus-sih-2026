# One place for every path/knob. Source this before any other script:
#   source config.env
# Override any value by exporting it first, e.g. WORK_ROOT=/kaggle/working/ps26052-gpu

# --- roots (Kaggle default; on another Linux GPU box export WORK_ROOT=$HOME/ps26052-gpu)
: "${WORK_ROOT:=/kaggle/working/ps26052-gpu}"
: "${DFN_TAG:=v0.5.6}"
: "${DFN_SOURCE:=$WORK_ROOT/dfn-v0.5.6}"

# --- raw archives (put the 3 downloads here; see 00_kaggle_checklist.md step 3)
: "${RAW_DIR:=$WORK_ROOT/raw}"
: "${VOICEBANK_ZIP:=$RAW_DIR/clean_trainset_28spk_wav.zip}"
: "${SESA_ZIP:=$RAW_DIR/SESA.zip}"
# ESC-50: upload EITHER the extracted repo dir OR ESC-50.zip (02_get_data.sh extracts it).
: "${ESC_DIR:=$RAW_DIR/ESC-50}"
: "${ESC_ZIP:=$RAW_DIR/ESC-50.zip}"
# Extracted forms (Kaggle auto-extracts dataset zips): when the zips are absent but these
# dirs hold the same bytes, 02/03 use them with structural gates (counts + frozen exclusion
# + content-hash). Provenance then rests on the private-dataset upload, stated in logs.
: "${VOICEBANK_DIR:=$RAW_DIR/voicebank}"
: "${SESA_DIR:=$RAW_DIR/sesa}"

# --- training knobs (starting experiment, not a proven optimum)
: "${MAX_EPOCHS:=6}"
: "${BATCH_SIZE:=2}"
: "${BATCH_SIZE_EVAL:=2}"
: "${LR:=0.0001}"

# --- expected sizes (sanity only, hashes are the real gate)
: "${VOICEBANK_MIN_BYTES:=2000000000}"
: "${SESA_SHA256:=fdc368afb948052933c6a4cb45449ef19dce6bae43aac929111a4daba5d653ec}"

export WORK_ROOT DFN_TAG DFN_SOURCE RAW_DIR VOICEBANK_ZIP SESA_ZIP ESC_DIR ESC_ZIP
export VOICEBANK_DIR SESA_DIR
export MAX_EPOCHS BATCH_SIZE BATCH_SIZE_EVAL LR
export VOICEBANK_MIN_BYTES SESA_SHA256
